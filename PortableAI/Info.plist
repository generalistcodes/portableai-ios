<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>PortableAI uses the camera to scan a pairing QR code.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PortableAI finds PortableAI servers on your local network and connects to the one you pair with.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_portableai._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
    <dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
